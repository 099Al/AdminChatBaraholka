# Telegram Bot API token from @BotFather.
BOT_TOKEN=telegram_bot_token

# Runtime mode. DEV stores SQLite in ./data/bot.db, PROD stores it in /app/data/bot.db.
ENV=DEV

# Optional full SQLAlchemy database URL override. Leave commented to use ENV-based SQLite defaults.
# DB_URL=sqlite+aiosqlite:///data/bot.db

# Main bot administrator Telegram user_id. Use /get_id in the bot to get it.
MAIN_ADMIN_USER=123456789

# Daily message limit per user before extra messages are deleted and the user becomes a block candidate.
LIMIT_MESSAGES=5

# Number of deleted flood messages after which the user becomes a block candidate.
FLOOD_MESSAGES_LIMIT=10

# Read-only restriction duration in days for daily limit violations.
BLOCKED_AFTER_LIMIT_DAYS=1

# Read-only restriction duration in days for repeated ads.
BLOCKED_AFTER_REPEAT_DAYS=7

# Read-only restriction duration in days for flood violations.
BLOCKED_AFTER_FLOOD_DAYS=1

# Period in days used to search for repeated ads.
REPEAT_PERIOD=7

# Number of days to keep saved messages in the local database.
MESSAGE_RETENTION_DAYS=7

# If true, repeated messages can be forwarded/copied to the bot for review where supported.
FORWARD_REPEATED_MESSAGES=false

# If true, Telethon reader reads all available messages instead of the retention window where supported.
READ_ALL_MESSAGES=false

# Interval in hours for scheduled runs between 10:00 and 22:00.
SCHEDULED_RUN_INTERVAL_HOURS=3

# Optional group/chat ids for terminal scheduler commands.
# If SCHEDULED_GROUP_CHAT_ID is empty, scheduler uses MAIN_ADMIN_USER's /bind group.
# If SCHEDULED_NOTIFY_CHAT_ID is empty, scheduler sends reports to MAIN_ADMIN_USER.
# SCHEDULED_GROUP_CHAT_ID=-1001234567890
# SCHEDULED_NOTIFY_CHAT_ID=123456789

# Number of unclassified messages processed per classifier run.
PROCESS_MESSAGE=500

# Enables automatic message classification on bot startup.
ENABLE_MESSAGE_CLASSIFICATION=true

# If true, bot sends found invalid messages to admin chat for manual review.
SEND_INVALID_MESSAGES_TO_BOT=false

# Classifier backend: local, ollama, or openai.
MESSAGE_CLASSIFICATION_BACKEND=openai

# OpenAI credentials when MESSAGE_CLASSIFICATION_BACKEND=openai.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Ollama endpoint and model when MESSAGE_CLASSIFICATION_BACKEND=ollama.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Telegram API credentials for Telethon history import.
API_ID=12345678
API_HASH=telegram_api_hash

# Phone number for the Telegram account used by Telethon, in international format.
PHONE=+79991234567

# Target group/channel for Telethon history import.
TELETHON_TARGET=https://t.me/example_group

# Telethon session file path.
TELETHON_SESSION_NAME=data/tg_session
